# ──────────────────────────────────────────────────
# TechStore App Tier — Local Development Environment
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your local values:
#   cp .env.example .env
#
# This file is ONLY used in development (NODE_ENV != production).
# On EC2, credentials come from AWS Secrets Manager.
# ──────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=ecommerce
DB_PORT=3306

# ── Application ──────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
PORT=4000

# ── Admin Seed (used by npm run dev:seed) ────────
ADMIN_EMAIL=admin@techstore.com
ADMIN_PASSWORD=Admin123
ADMIN_NAME=Administrator
